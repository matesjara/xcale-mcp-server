# xcale-mcp-server — environment.
# Real secrets live in Doppler, NEVER in a committed .env. This file documents the shape only.

# Hop B — how a consumer (e.g. xcale-backend) authenticates TO this server (shared secret).
MCP_SERVER_SECRET=replace-me-in-doppler

# --- Credential Authority callback (the `reference` delivery strategy) -------
# Empty = this server serves only `forwarded` providers and never calls back. When set it must be an
# https: URL (locally too: the backend's https://localhost) — anything else refuses to boot, since this
# is where the callback secret below is sent.
# CREDENTIAL_RESOLVE_URL=https://<consumer-host>/internal/credentials/resolve
#
# What we present when calling that endpoint. Deliberately NOT `MCP_SERVER_SECRET`: that one
# authenticates the opposite direction, and the resolve endpoint hands back a usable provider
# credential — one symmetric value guarding both meant a leak in either direction opened both.
# Empty falls back to MCP_SERVER_SECRET so this server and the consumer can be rolled forward
# independently; the fallback is a migration affordance, not the target state.
# CREDENTIAL_RESOLVE_SECRET=replace-me-in-doppler

# HTTP
PORT=8080
NODE_ENV=development

# Logging (pino)
LOG_LEVEL=info

# --- Providers: deployment config (non-secret) -------------------------------
# Toteat (restaurant POS). Production and development share one adapter; the base URL selects the
# environment. The *.appspot.com hosts — including the one in Toteat's own OpenAPI `servers:` block —
# are legacy and return incomplete data. Never use them.
#   production : https://api.toteat.com/mw/or/1.0
#   development: https://apidev.toteat.com/mw/or/1.0
TOTEAT_BASE_URL=https://api.toteat.com/mw/or/1.0

# Siigo (accounting). xcale's `Partner-Id` — a NON-secret institutional identifier required on every
# Siigo DATA call (Observed: data endpoints 400 with `header_required` when it is missing; the /auth
# mint accepts it optionally). This server applies its copy on data egress; the backend applies its
# own copy on the mint — so the SAME value must exist in both deployments' config. Sandbox value:
# `EcomerceCG` (alt `BivooRetailSuite`). Empty = every Siigo data call fails 400 (deployment misconfig).
SIIGO_PARTNER_ID=replace-me-in-doppler

# --- HiMed API hosts (deployment config, every env) --------------------------
# The two hosts HiMed's tools call: Demográficos + directory, and Autoagendamiento. They are
# deployment config, NOT credentials. The values below are HiMed's sandbox, for local dev; Doppler
# `prd` (and .do/app.yaml) carries HiMed's production hosts. Empty = HiMed's tools fail closed and
# the server warns at boot.
# A clinic's tokens and codigo_servicio never live here: like any tenant credential, the consumer
# custodies them (xcale Rail A) and forwards them per call in `X-Provider-Credentials`.
HIMED_BASE_URL=https://demo.medsas.co/interoperabilidad/Api/Controllers
HIMED_SCHEDULING_BASE_URL=https://demo-notificaciones.medsas.co/notificaciones/envioConsumoAutoagendamiento